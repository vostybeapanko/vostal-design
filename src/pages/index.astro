---
import Base from '../layouts/Base.astro';
import { site, projects, services, sectors, url } from '../lib/data.js';

// data pro klientský skript (filtry, pás, chat)
const data = {
  site: { email: site.email, emptyText: site.emptyText, chat: site.chat },
  idle: { ...(site.idle || {}), media: (site.idle?.media || []).map(m => url(m)) },
  services, sectors,
  projects: projects.map(p => ({
    slug: p.slug, title: p.title, tag: p.tag, label: p.label,
    services: p.services, sectors: p.sectors,
    href: url(`/projekty/${p.slug}/`),
    card: { ...p.card, cover: url(p.card?.cover), hoverMedia: url(p.card?.hoverMedia) },
    reel: (p.reel || []).map(m => url(m)),
  })),
  specials: (site.specialCards || []).map(c => ({ ...c, link: url(c.link) })),
};
---
<Base>
  <main class="home">
    <section class="hero">
      <h1>{site.heading}</h1>
      <form class="ask" id="ask" autocomplete="off">
        <input id="q" aria-label="Napiš zprávu" placeholder={site.placeholder}>
        <button id="send" type="submit" disabled aria-label="Odeslat">→</button>
      </form>

      <nav class="filters" id="filters" aria-label="Filtrovat projekty">
        <div class="frow" data-group="service" role="group" aria-label="Co jsem dělal">
          {services.map(s => <button type="button" data-v={s} data-t={s} aria-pressed="false">{s}</button>)}
        </div>
        <div class="frow" data-group="sector" role="group" aria-label="Obor">
          {sectors.map(s => <button type="button" data-v={s} data-t={s} aria-pressed="false">{s}</button>)}
        </div>
        <button class="reset" id="reset" type="button">Zrušit výběr ×</button>
      </nav>
      <div class="chat" id="chat" aria-live="polite"></div>
    </section>

    <section class="rail" id="rail" aria-label="Projekty">
      <div class="track nojs" id="track">
        <!-- bez JavaScriptu: obyčejný seznam projektů (i pro vyhledávače) -->
        {projects.map(p => (
          <div class="item">
            <div class="meta"><span>{p.label}</span><span>{p.sectors.join(', ')}</span></div>
            <a class="card" href={url(`/projekty/${p.slug}/`)} style={`background:${p.card.bg};color:${p.card.ink}`}>
              <div class="art"><span class="sub">{p.card.eyebrow}</span><span class="big">{p.card.bigText}</span></div>
            </a>
          </div>
        ))}
      </div>
    </section>

    <footer class="foot" id="foot">
      <button class="tog" id="tog" aria-label="Zobrazit patičku">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M9 1v16M1 9h16M3.3 3.3l11.4 11.4M14.7 3.3 3.3 14.7"/></svg>
      </button>
      <div class="links">
        <span>{site.footerText}</span>
        {site.instagram && <a href={site.instagram}>Instagram</a>}
        {site.linkedin && <a href={site.linkedin}>LinkedIn</a>}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </footer>
    <div class="count" id="count"></div>
  </main>

  <!-- spořič: po nečinnosti rychlé střihy přes všechny značky -->
  <div class="idle" id="idle" aria-hidden="true">
    <div class="idle-stage" id="idleStage"></div>
    <div class="idle-text"><i></i><span>{site.idle?.text}</span><i></i></div>
  </div>

  <script type="application/json" id="data" set:html={JSON.stringify(data)} />
  <script src="../scripts/home.js"></script>
</Base>
